# Documentation only: .env is NOT loaded automatically. Set process environment.
# Generate a real key locally; never commit, print or pass it in a URL.
ASSAR_API_KEY=
ASSAR_HOST=127.0.0.1
ASSAR_PORT=8000
ASSAR_MAX_UPLOAD_BYTES=104857600
ASSAR_MAX_JPEG_BYTES=5242880
ASSAR_REQUEST_TIMEOUT_SEC=300
ASSAR_ANALYSIS_BUDGET_SEC=240
ASSAR_GPU_WORKERS=1
ASSAR_MAX_INFLIGHT_JOBS=1
ASSAR_UPLOADS_DIR=uploads
ASSAR_OUTPUTS_DIR=outputs
ASSAR_MODEL_CONFIG_PATH=configs/model.yaml
ASSAR_RULES_CATALOG_PATH=app/rules/catalog.json
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
WANDB_MODE=disabled
OTEL_SDK_DISABLED=true
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
